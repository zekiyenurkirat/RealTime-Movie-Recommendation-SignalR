@{
    ViewData["Title"] = "Film Seç";
}

<div class="main-container">

    <div id="loginSection" class="glass-card">
        <h2>👋 Ekibi Topla</h2>
        <div class="input-group mb-3">
            <span class="input-group-text bg-transparent border-0 text-white"><i class="fas fa-user"></i></span>
            <input type="text" id="userInput" class="form-control" placeholder="Adın ne?">
        </div>
        <div class="input-group mb-3">
            <span class="input-group-text bg-transparent border-0 text-white"><i class="fas fa-key"></i></span>
            <input type="text" id="roomInput" class="form-control" placeholder="Oda Kodu">
        </div>
        <button onclick="joinRoom()" class="btn-custom btn-primary-custom">Odaya Dal</button>
        <div id="userList" class="mt-4 text-white-50 small"></div>
    </div>

    <div id="suggestSection" class="glass-card" style="display:none;">
        <h3>🍿 Film Öner</h3>
        <input type="text" id="favMovieInput" class="form-control text-center" placeholder="Örn: Inception">
        <button onclick="submitMovie()" id="btnSubmitMovie" class="btn-custom btn-primary-custom" style="background: #e50914;">Ekle</button>
        <p id="waitText" class="mt-3 text-success" style="display:none;"><i class="fas fa-check"></i> Film alındı!</p>

        <button onclick="startAnalysis()" id="btnStartGame" class="btn-custom btn-primary-custom mt-3" style="background: #28a745; opacity: 0.5; cursor: not-allowed;">Herkesin Bitirmesi Bekleniyor...</button>
    </div>

    <div id="votingSection" style="display:none;">
        <h3 class="mb-4">🔥 Seçim Zamanı</h3>
        <div class="card-stack" id="cardStack"></div>
        <div class="mt-5 d-flex justify-content-center gap-4">
            <button onclick="handleVote(false)" class="btn-vote btn-dislike"><i class="fas fa-times"></i></button>
            <button onclick="handleVote(true)" class="btn-vote btn-like"><i class="fas fa-heart"></i></button>
        </div>
    </div>

    <div id="waitingOthersSection" class="glass-card" style="display:none;">
        <h3>⏳ Sonuçlar Hesaplanıyor...</h3>
        <div class="loader-container"><div class="popcorn-loader">🍿</div></div>
    </div>

    <div id="resultSection" class="glass-card" style="display:none; border-color: #46d369;">
        <div class="display-1 mb-3">🎉</div>
        <h2 class="text-success">EŞLEŞME BULUNDU!</h2>

        <div class="card bg-dark text-white border-0 shadow-lg my-4" style="overflow: hidden;">
            <div style="position: relative; width: 100%; display: flex; justify-content: center;">
                <img id="resultImg" src="" class="card-img-top" style="max-height: 400px; object-fit: cover; opacity: 0.8;">

                <button id="resultPlayBtn" class="btn btn-danger rounded-circle shadow-lg"
                        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80px; height: 80px; font-size: 32px; display: none; z-index: 999; border: 4px solid white; box-shadow: 0 0 20px rgba(229, 9, 20, 0.8);">
                    <i class="fas fa-play"></i>
                </button>
            </div>

            <div class="card-body">
                <h3 id="resultTitle" class="card-title text-center m-0"></h3>
            </div>
        </div>

        <div id="platformsDiv" class="mb-3" style="display:none;">
            <p class="small text-muted mb-2">Burada izleyebilirsin:</p>
            <div id="providerLogos" class="d-flex justify-content-center gap-2 flex-wrap"></div>
        </div>

        <button onclick="location.reload()" class="btn-custom btn-primary-custom">Tekrar Oyna 🔄</button>
    </div>
</div>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-black">
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <iframe id="trailerFrame" src="" allowfullscreen></iframe>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-2" data-bs-dismiss="modal" onclick="closeTrailer()"></button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>